<?xml version="1.0"?>
<ruleset name="Laravel Standards">
    <description>PSR-12 coding standard for Laravel</description>

    <!-- Проверяемые директории -->
    <file>app</file>
    <file>config</file>
    <file>database</file>
    <file>routes</file>
    <file>tests</file>

    <!-- Исключения -->
    <exclude-pattern>*/cache/*</exclude-pattern>
    <exclude-pattern>*.blade.php</exclude-pattern>

    <!-- Базовый стандарт PSR-12 -->
    <rule ref="PSR12"/>

    <!-- Разрешаем имена методов в snake_case для тестов (например, test_user_can_login) -->
    <rule ref="PSR1.Methods.CamelCapsMethodName.NotCamelCaps">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- Настройка длины строки (предупреждение на 120 символах) -->
    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="120"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>
</ruleset>
